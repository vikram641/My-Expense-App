<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.example.expense.feature.home.HomeViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary">

            <!-- AppBar -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_primary"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp">

                    <!-- Greeting -->
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@{vm.userName}"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnAskAi"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Date -->
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text='@{vm.selectedMonth != null ? vm.selectedMonth : "Select Month"}'
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintStart_toStartOf="@id/tvGreeting"
                        app:layout_constraintTop_toBottomOf="@id/tvGreeting"/>

                    <!-- Ask FixMoney -->
                    <ImageView
                        android:id="@+id/btnAskAi"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ai_button"
                        android:padding="10dp"
                        android:src="@drawable/ic_sparkle"
                        android:contentDescription="Ask FixMoney"
                        app:tint="@color/accent"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="14dp"
                        app:layout_constraintEnd_toStartOf="@id/avatar"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Avatar -->
                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_button"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Offline Banner -->
                <TextView
                    android:id="@+id/tvOfflineBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#CC3D1500"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="📡  No internet connection  ·  Showing cached data"
                    android:textColor="#FFCC44"
                    android:textSize="12sp"
                    android:visibility="gone"/>

            </com.google.android.material.appbar.AppBarLayout>

            <!-- Swipe -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- AI INSIGHT CARD - computed locally (see HomeInsightEngine), not
                             AI-generated, so it costs nothing and never shows a fabricated
                             insight: hidden entirely when there's no real signal. -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/aiInsightCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_ai_insight_card"
                            android:padding="16dp"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:id="@+id/ivInsightSparkle"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_sparkle"
                                app:tint="@color/accent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="@id/tvInsightLabel"/>

                            <TextView
                                android:id="@+id/tvInsightLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="AI INSIGHT"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                app:layout_constraintStart_toEndOf="@id/ivInsightSparkle"
                                app:layout_constraintTop_toTopOf="parent"/>

                            <TextView
                                android:id="@+id/tvInsightMain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:lineSpacingExtra="2dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvInsightLabel"
                                tools:text="Food spending is up 38% this week vs your average"/>

                            <TextView
                                android:id="@+id/tvInsightForecast"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:visibility="gone"
                                tools:visibility="visible"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvInsightMain"
                                tools:text="On track to exceed budget by Aug 24 at this pace"/>

                            <LinearLayout
                                android:id="@+id/insightForecastBar"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_chat_bar_track"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                tools:visibility="visible"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvInsightForecast">

                                <View
                                    android:id="@+id/insightFillToday"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.7"
                                    android:background="@drawable/bg_gradient_rect"/>

                                <View
                                    android:id="@+id/insightFillWarningZone"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.2"
                                    android:background="@color/text_warning"/>

                                <View
                                    android:id="@+id/insightFillRemainder"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.1"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvInsightToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Today"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp"
                                android:visibility="gone"
                                tools:visibility="visible"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/insightForecastBar"/>

                            <TextView
                                android:id="@+id/tvInsightOverageLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_warning"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:text="Projected overage · Aug 24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/insightForecastBar"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- MAIN CARD -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/mainCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_card"
                            android:elevation="@dimen/padding_16"
                            android:padding="12dp"
                            app:layout_constraintTop_toBottomOf="@id/aiInsightCard"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <TextView
                                android:id="@+id/tvTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL SPENT THIS MONTH"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>

                            <TextView
                                android:id="@+id/tvAmount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@={vm.totalSpent}"
                                android:textColor="@color/text_primary"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

                            <ProgressBar
                                android:id="@+id/progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progress="@{vm.progress}"
                                android:progressDrawable="@drawable/progress_bar"
                                android:layout_marginTop="8dp"
                                app:layout_constraintTop_toBottomOf="@id/tvAmount"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>

                            <TextView
                                android:id="@+id/tvBudget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{vm.totalBudget}"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:layout_marginTop="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/progress"/>

                            <TextView
                                android:id="@+id/tvWarning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:background="@drawable/bg_chip"
                                android:padding="6dp"
                                android:text="⚠ Near limit"
                                android:textColor="@color/text_warning"
                                app:layout_constraintTop_toTopOf="@id/tvBudget"
                                app:layout_constraintEnd_toEndOf="parent"/>

                            <LinearLayout
                                android:id="@+id/rowBoxes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="20dp"
                                app:layout_constraintTop_toBottomOf="@id/tvBudget"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="80dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_card"
                                    android:gravity="center"
                                    android:text="@{vm.weekSpent}"
                                    android:textColor="@color/green"
                                    android:textSize="16sp"/>

                                <Space
                                    android:layout_width="12dp"
                                    android:layout_height="match_parent"/>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="80dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_card"
                                    android:gravity="center"
                                    android:text="@{vm.remainingAmount}"
                                    android:textColor="@color/purple"
                                    android:textSize="16sp"/>

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- CHART CARD -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/constraintLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_card"
                            android:elevation="@dimen/padding_16"
                            android:padding="12dp"
                            app:layout_constraintTop_toBottomOf="@id/mainCard"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChart"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintWidth_percent="0.4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvLegend"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:overScrollMode="never"
                                android:scrollbars="vertical"
                                app:layout_constraintStart_toEndOf="@id/pieChart"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                tools:itemCount="5"
                                tools:listitem="@layout/item_legend_row"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- RECENT -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/recentHeaderRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="20dp"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:layout_constraintTop_toBottomOf="@id/constraintLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <TextView
                                android:id="@+id/tvRecentTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recent"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>

                            <TextView
                                android:id="@+id/tvSeeAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="See all"
                                android:textColor="@color/accent"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tvRecentTitle"
                                app:layout_constraintBottom_toBottomOf="@id/tvRecentTitle"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintTop_toBottomOf="@id/recentHeaderRow"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_expenses"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:visibility="gone"
                android:layout_margin="20dp"
                android:src="@android:drawable/ic_input_add"
                app:backgroundTint="@color/text_accent"/>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Loader -->
        <FrameLayout
            android:id="@+id/loaderLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/bg_primary"
            android:clickable="true"
            android:focusable="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieProgress"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/expense"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>

        </FrameLayout>

    </FrameLayout>

</layout>